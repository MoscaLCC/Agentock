# Autenticação dos agentes LLM: subscription = login do Claude Code (ignora a ANTHROPIC_API_KEY do ambiente);
# api = créditos da API (ANTHROPIC_API_KEY)
AGENTOCK_CLAUDE_AUTH=subscription

# Telegram (alertas) — ver: python tools/telegram_setup.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEC EDGAR exige User-Agent com nome e contacto (ASCII)
SEC_USER_AGENT=

# Coreia: comunicados oficiais (OpenDART, chave grátis)
DART_API_KEY=

# Fornecedores de dados (planos grátis) — ver docs/PLANO.md secção 3.4
FMP_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
TWELVEDATA_API_KEY=
EODHD_API_KEY=
MARKETSTACK_API_KEY=
TIINGO_API_KEY=
ITICK_API_KEY=
GURUFOCUS_API_TOKEN=
